# Copy this file before starting Vite:
# cp apps/client/.env.example apps/client/.env.local

# LAN multiplayer: replace this with the game-server laptop's current LAN IP.
# Every laptop must point to the same server. For a single-computer test, use:
# VITE_SERVER_URL=http://localhost:3001
# VITE_SERVER_URL=http://172.26.0.171:3001
VITE_SERVER_URL=http://localhost:3001
# false = real camera recognition; true = show manual identity controls.
VITE_IDENTITY_DEBUG_MODE=false
